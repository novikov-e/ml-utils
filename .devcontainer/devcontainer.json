{
  "name": "ML Utils",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "runArgs": [
    "--name",
    "ml-utils"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "astral-sh.ty"
      ]
    }
  },
  "postCreateCommand": "pip3 install --no-cache-dir -r requirements.txt",
  "remoteUser": "vscode"
}